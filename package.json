{
  "name": "dsh-web-search-ollama",
  "version": "0.1.1",
  "description": "Ollama-backed search provider for the DeepSeek Harness web capability seam (ctx.web): adapts Ollama /api/web_search into dsh web_search tool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sryimnoob123/dsh-web-search-ollama.git"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.8",
    "node": ">=18.17.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "search",
    "ollama"
  ]
}
